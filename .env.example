APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default lokal: SQLite (tanpa password, cepat). Buat file: database/database.sqlite
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# PostgreSQL lokal (opsional — isi DB_PASSWORD jika server menuntut password)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=imersi
# DB_USERNAME=postgres
# DB_PASSWORD=

# PostgreSQL (optional overrides when MySQL is the default connection)
# PGSQL_HOST=127.0.0.1
# PGSQL_PORT=5432
# PGSQL_DATABASE=imersi
# PGSQL_USERNAME=postgres
# PGSQL_PASSWORD=

# MySQL / SQL — always available via DB::connection('mysql')
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=imersi
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Neon Postgres — satu database bersama untuk admin, dosen, dan mentor.
# Pakai connection string pooled (host mengandung -pooler) supaya request cepat.
# Salin URL yang sama ke setiap komputer. Jangan commit URL yang berisi password.
# DB_CONNECTION=neon
# NEON_POOLED=true
NEON_DATABASE_URL=
# Host langsung (tanpa -pooler) untuk migrate/seed. Jangan pakai channel_binding=require.
# NEON_DIRECT_URL=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
BROWSERSHOT_NODE_BINARY=node
BROWSERSHOT_CHROME_PATH=

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Opsional. Kosongkan agar memakai resources/certs/cacert.pem (diperlukan di Windows).
# MAIL_CAFILE=
MAIL_FROM_ADDRESS="noreply@imersi.id"
MAIL_FROM_NAME="Magang Dosen"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FRONTEND_URL=http://localhost:8000

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
# Authorized redirect URI in Google Cloud Console must include:
# http://localhost:8000/auth/google/callback

# --- Queue ---
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=sqlite
# For production: database, redis, sqs, beanstalkd, sync

# --- Cache ---
CACHE_PREFIX=imersi_
# CACHE_STORE=file (default)

# --- Redis ---
REDIS_CLUSTER=redis
REDIS_PERSISTENT=false
REDIS_CACHE_DB=1
# REDIS_URL=redis://127.0.0.1:6379

# --- Database ---
DB_URL=
DB_FOREIGN_KEYS=true
DB_PERSISTENT=false

# --- MySQL ---
MYSQL_URL=
MYSQL_SOCKET=
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_ATTR_SSL_CA=

# --- PostgreSQL ---
PGSQL_URL=
PGSQL_CHARSET=utf8
PGSQL_SSLMODE=prefer
PGSQL_POOLED=false
PGSQL_DIRECT_HOST=
PGSQL_DIRECT_PORT=
PGSQL_DIRECT_USERNAME=
PGSQL_DIRECT_PASSWORD=
PGSQL_DIRECT_SSLMODE=

# --- Neon ---
NEON_HOST=
NEON_PORT=5432
NEON_DATABASE=neondb
NEON_USERNAME=
NEON_PASSWORD=
NEON_CHARSET=utf8
NEON_SSLMODE=require
NEON_POOLED=true
NEON_DIRECT_URL=
NEON_DIRECT_HOST=
NEON_DIRECT_PORT=
NEON_DIRECT_USERNAME=
NEON_DIRECT_PASSWORD=
NEON_DIRECT_SSLMODE=require

# --- Mail ---
MAIL_URL=
MAIL_EHLO_DOMAIN=

# --- Third Party Services ---
POSTMARK_API_KEY=
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=